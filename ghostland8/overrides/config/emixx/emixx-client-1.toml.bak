[creativeModeTabs]
	enableCreativeModeTabs = true
	syncSelectedCreativeModeTab = true

[stackGroups]
	enableStackGroups = true
	disabledStackGroups = ["minecraft:shovels", "minecraft:pickaxes", "minecraft:axes", "minecraft:head_armor", "minecraft:swords", "minecraft:chest_armor", "minecraft:leg_armor", "minecraft:foot_armor", "c:raw_materials", "minecraft:infested_blocks", "minecraft:animal_armors", "c:foods", "minecraft:rails", "minecraft:skulls", "minecraft:minecarts", "c:dyes", "c:ores", "c:seeds", "minecraft:flowers", "minecraft:boats", "c:buckets", "minecraft:copper_blocks", "minecraft:walls"]
