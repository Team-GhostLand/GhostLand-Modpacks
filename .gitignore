# == GENERAL ==

# Grinch local workspace stuff
**.gr-workspace
**.mrpack

# For everyone who stores Grinch locally in the workspace
grinch
grinch.exe


# == GHOSTLAND 7 ==

# Leaks local world names: (which isn't really a „leak” as in a „security issue” (there's nothing insecure about your world name, unless you're insecure about the silly way you call your worlds), but this has caused Windows incompatibilities (lol) in the past)
ghostland7/overrides/config/inventoryprofilesnext

# Leaks usernames/IDs:
ghostland7/overrides/config/sounds/chat.json
ghostland7/overrides/config/skinrestorer/mojang_profile_cache.json
ghostland7/overrides/config/sodium-fingerprint.json
ghostland7/overrides/config/jade/usernamecache.json
ghostland7/overrides/config/roughlyenoughitems/hints.json
ghostland7/overrides/config/voicechat/username-cache.json

# Temporary files
ghostland7/overrides/config/spark/tmp

# Copyright violations lol
ghostland7/overrides/config/analog/records

# Distant Horizons interprets values differently on different devices - better to remove its configs and have everything set to default; its server-version is in server-overrides
#ghostland7/overrides/config/DistantHorizons.toml

# Leaks personal access tokens; its server-version is in server-overrides
ghostland7/overrides/config/PacketAuth/config.yml

# Its server-version is in server-overrides
ghostland7/overrides/config/discord_chat_mod-common.toml


# == GHOSTLAND 8 ==

# Sinytra cache (unfortunately, one of the files inside (the log/report) is unignorable, so we'll need to remove it every time)
ghostland8/overrides/mods/.connector

# EMI accelerator cache and report
ghostland8/overrides/config/emi-accelerator/reload-timings.json
ghostland8/overrides/config/emi-accelerator/stack-cache.emic

# Spark temporary files
ghostland8/overrides/config/spark/tmp
ghostland8/overrides/config/spark/tmp-client

# Spark leaks usernames and IDs
ghostland8/overrides/config/spark/activity.json